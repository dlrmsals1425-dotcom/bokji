# 공공데이터포털(data.go.kr) 일반 인증키 — 데이터 파이프라인(수집)에서만 사용. 앱 런타임에는 필요 없음.
# 15113968 공공서비스(혜택) · 15090532 중앙부처복지서비스 · 15108347 지자체복지서비스 활용신청 승인된 키. 절대 커밋 금지.
DATA_GO_KR_SERVICE_KEY=
# (선택) 하루 API 호출 예산 (기본 2000, 개발계정 한도 10000)
# GOV24_DAILY_BUDGET=2000
# (선택) 복지로 중앙·지자체 API 일일 예산 (개발계정 한도 100 / 1000)
# BOKJIRO_CENTRAL_BUDGET=95
# BOKJIRO_LOCAL_BUDGET=950

# 자체 STT 모델 서버 — 서버 전용. NEXT_PUBLIC_ 접두사를 붙이지 않는다.
# 로컬은 http://127.0.0.1:8767, 별도 배포 서버는 HTTPS 주소를 사용한다.
STT_SERVICE_URL=
# 웹 서버와 STT 서버에 동일한 32자 이상 임의 비밀값 설정. 키 값은 커밋하지 않는다.
STT_SERVICE_TOKEN=
